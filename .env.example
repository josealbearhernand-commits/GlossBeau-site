# Copy this file to .env.local and fill in the token. .env.local is ignored by git and never committed.
# Values come from Shopify admin › Sales channels › Headless › your storefront › Storefront API.
SHOPIFY_STORE_DOMAIN=2rfhas-it.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=paste-your-public-storefront-access-token-here
# Optional: Storefront API version (defaults to 2026-07)
SHOPIFY_API_VERSION=2026-07
# Newsletter sign-ups (server only): Dev Dashboard app "GlossBeau newsletter", scopes write_customers + read_customers.
# The server trades these for a 24-hour Admin API token (client credentials grant). Never commit real values.
SHOPIFY_ADMIN_CLIENT_ID=paste-client-id-here
SHOPIFY_ADMIN_CLIENT_SECRET=paste-client-secret-here
